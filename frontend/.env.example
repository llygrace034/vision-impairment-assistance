# ---------------------------------------------------------------------------
# frontend/.env.example  ->  copy to frontend/.env.local and edit
#
# frontend/.gitignore ignores *.local, so .env.local is never committed.
# Only VITE_-prefixed vars reach the browser; this app needs exactly one, and
# it holds no secret. The ElevenLabs and Gemini keys stay on the backend.
# ---------------------------------------------------------------------------

# Base URL of the LetterLens FastAPI backend (/signed-url and /read_document).
# App.tsx falls back to http://127.0.0.1:8000 when this is unset, which is what
# `uvicorn backend.app:app` serves locally — so for a laptop demo you do not
# need this file at all.
#
# Override it when the backend is not on this machine's loopback:
#   - demoing from a phone, which cannot reach the laptop's 127.0.0.1
#     (use the laptop's LAN IP, e.g. http://192.168.1.42:8000)
#   - the browser is served over https, so the backend must be https too
#     (a tunnel such as ngrok: https://<subdomain>.ngrok-free.app)
#   - a non-default port, or a deployed backend
#
# No trailing slash: the code appends "/read_document" directly.
VITE_BACKEND_URL=http://127.0.0.1:8000

# Paired setting on the OTHER side: the backend only accepts browser origins
# listed in CORS_ORIGINS (root .env.local, default "http://localhost:5173").
# If you change where the page is served from -- 127.0.0.1 instead of
# localhost, a LAN IP, or a tunnel -- add that exact origin there too, or the
# fetch is blocked by CORS and the agent just says it could not reach the
# reader. Serve the dev page to a phone with `npm run dev -- --host`.
