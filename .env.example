# ---- Google AI Studio / Gemini API (serves the Gemma models) ----
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Conversational brain + vision model. Pinned here, never hard-coded in source.
# Only TWO Gemma models are served by the Gemini API: gemma-4-26b-a4b-it and
# gemma-4-31b-it. The old pin (gemma-3-27b-it) 404s -- see
# docs/research/08-gemma-live-api-test-results.md section 2.
#
# USE 26b. Measured head-to-head (note 08 sections 6.1 and 10):
#   26b: text 2.0s median, 8/8 ok   | vision 3.7-4.5s, 3/3 correct
#   31b: text 29.4s median, 6/8 ok  | vision 36.8-56.8s
# 26b is ~12x faster on text, ~10x on vision, and did not fail once in 19 calls.
# Vision is verified on 26b against all three letters in test-letters/.
GEMMA_MODEL=gemma-4-26b-a4b-it
# Vision model used by read_document (may differ from the chat model).
GEMMA_VISION_MODEL=gemma-4-26b-a4b-it
# Optional non-Gemma fallback used only if the Gemma call fails outright.
FALLBACK_MODEL=

# Per-request timeout for any model call, milliseconds.
LLM_TIMEOUT_MS=8000

# ---- Split model paths: NO LONGER NEEDED ----
# These were added when the only latency data came from gemma-4-31b-it (20-57s,
# ~50% failure), which made a split architecture necessary. That data does not
# apply to 26b: it answers in 2.0s (text) and 3.7-4.5s (vision), so ONE Gemma
# model serves both paths inside the 8s budget above. See note 08 section 10.
# Leave these commented out. Re-evaluate only if the model pin changes back.
#CHAT_MODEL=gemini-2.5-flash-lite
#VISION_TIMEOUT_MS=90000

# ---- ElevenLabs Agents ----
# Get a key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# ---- Networking ----
# Public HTTPS base URL of this backend (ngrok/cloudflared), no trailing slash.
# ElevenLabs server tools and the Custom LLM endpoint are reached through this.
PUBLIC_BASE_URL=

# Shared secret ElevenLabs must send back to authenticate webhook tool calls.
TOOL_WEBHOOK_SECRET=

# Local bind
HOST=127.0.0.1
PORT=8000

# Comma-separated origins allowed to call the backend from the browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
